import random
class car:
    def __init__(self,resignation , max_speed):
           
        self.resignation=resignation
        self.maxspeed=max_speed
        self.currentspeed=0
        self.distancetravelled=0
    def accelerate(self,speed):
         self.currentspeed+=speed
         if self.currentspeed>self.maxspeed:
             self.currentspeed=self.maxspeed
         if self.currentspeed<0:
             self.currentspeed=0
    def drive(self,hours):
        self.distancetravelled+=hours*self.currentspeed    



class Race:
    def __init__(self, name, distance, carlist):
        self.name = name
        self.distance = distance
        self.carlist = carlist
        self.hours = 0  # track total hours passed

    def hour_passes(self):
        self.hours += 1
        for car in self.carlist:
            car.accelerate(random.randint(-10, 15))
            car.drive(1)

    def print_status(self):
        print(f"\n{'='*55}")
        print(f"  {self.name} — Hour {self.hours}")
        print(f"{'='*55}")
        print(f"{'Car':<8} {'Max Spd':>8} {'Curr Spd':>9} {'Distance':>10}")
        print(f"{'-'*55}")

        # sort by distance travelled
        sorted_cars = sorted(self.carlist, key=lambda x: x.distancetravelled, reverse=True)

        for car in sorted_cars:
            # show finish flag if car finished
            flag = "🏁" if car.distancetravelled >= self.distance else "  "
            print(f"{car.resignation:<8} {car.maxspeed:>7} {car.currentspeed:>8} {car.distancetravelled:>10.1f} km {flag}")

        print(f"{'='*55}")

    def race_finished(self):
        return any(car.distancetravelled >= self.distance for car in self.carlist)


carlist = []
for i in range(1, 11):
    resignum = f"ABC-{i}"
    speedmax = random.randint(150, 200)
    cars = car(resignum, speedmax)
    carlist.append(cars)


race = Race("Grand Demolition Derby", 8000, carlist)

print(f"🏎️  Welcome to the {race.name}!")
print(f"📍 Race distance: {race.distance} km")
print(f"🚗 Cars participating: {len(race.carlist)}")


while not race.race_finished():
    race.hour_passes()


    if race.hours % 10 == 0:
        race.print_status()


print("\n RACE FINISHED!")
race.print_status()


winner = max(race.carlist, key=lambda x: x.distancetravelled)
print(f"\n Winner is {winner.resignation} with {winner.distancetravelled:.1f} km!")
print(f"\n  Race completed in {race.hours} hours!")