class elavator:
    def __init__(self,bottom_floor,top_floor):
        self.currentfloor=bottom_floor
        self.bottomfloor=bottom_floor
        self.topfloor=top_floor
    def floorup(self):
        if self.currentfloor<self.topfloor:
            self.currentfloor += 1
            print(f"Moving up rn ... Thank you for waiting , the currerent floor is {self.currentfloor}")
    def floordown(self):
        if self.currentfloor>self.bottomfloor:
            self.currentfloor -= 1
            print(f"Moving down rn ... Thank you for waiting , the currerent floor is {self.currentfloor}")
    def targetfloor(self,desfloor):
        while self.currentfloor<desfloor:
            self.floorup()
        while self.currentfloor>desfloor:
            self.floordown()
class Building:
    def __init__(self,floortop,floorbottom,elavatorsnumb):
        self.topfloor=floortop
        self.bottomfloor=floorbottom
        self.elavators=[]
        for i in range(elavatorsnumb):
            new_elavator=elavator(self.bottomfloor,self.topfloor)
            self.elavators.append(new_elavator)
    def elavator_move(self,elavator,targetedfloor):
        print (f"\n Now moving elavator{elavator} to floor {targetedfloor}")
        elavator_order=elavator-1
        the_elevator = self.elavators[elavator_order]
        the_elevator.targetfloor(targetedfloor)
        
